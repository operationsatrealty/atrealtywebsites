{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "projects": {
    "sam-brett": {
      "rootDirectory": "sam-brett"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
